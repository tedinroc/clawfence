{
  "name": "clawfence",
  "version": "0.1.0",
  "description": "Intent firewall for OpenClaw: scope-aware tool adjudication with a physical arbiter",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib",
    "arbiter",
    "assets",
    "README.md",
    "LICENSE",
    "openclaw.plugin.json",
    "scenarios",
    "scripts"
  ],
  "dependencies": {},
  "peerDependencies": {
    "openclaw": ">=2026.11.4"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.4",
      "minGatewayVersion": "2026.11.4"
    },
    "build": {
      "openclawVersion": "2026.11.4",
      "pluginSdkVersion": "2026.11.4"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "eval": "node scripts/eval.mjs",
    "arbiter": "node arbiter/server.mjs"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  }
}